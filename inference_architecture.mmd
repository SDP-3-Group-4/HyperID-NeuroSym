%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ffffff', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#f4f4f4'}}}%%
graph TD
    %% Define Styles
    classDef input fill:#e8f4f8,stroke:#2980b9,stroke-width:2px,color:#2c3e50,rx:5px,ry:5px;
    classDef model fill:#fdedec,stroke:#c0392b,stroke-width:2px,color:#641e16,rx:10px,ry:10px;
    classDef process fill:#eafaf1,stroke:#27ae60,stroke-width:2px,color:#145a32,rx:10px,ry:10px;
    classDef data fill:#fcf3cf,stroke:#f1c40f,stroke-width:2px,color:#7d6608,rx:5px,ry:5px;
    classDef output fill:#ebdef0,stroke:#8e44ad,stroke-width:2px,color:#4a235a,rx:5px,ry:5px;
    classDef hidden fill:none,stroke:none;

    %% 1. Input Layer
    A["📷 <b>Input Photo</b><br><small>(Mixed Breed / Stray)</small>"]:::input
    
    %% 2. Visual Perception Branch
    subgraph VisualBranch [Visual Perception Branch]
        B["👁️ <b>CLIP Vision Encoder</b><br><small>(ViT-B/32, Frozen)</small>"]:::model
        C[("📊 <b>512-D Embedding</b>")]:::data
        D["🧠 <b>Multi-Task Trait Network</b><br><small>(6 Parallel Classification Heads)</small>"]:::model
        E["📈 <b>Neural Trait Probabilities</b><br><small>(P_NN)</small>"]:::process
    end

    %% 3. Textual / Zero-Shot Branch
    subgraph TextBranch [Zero-Shot Knowledge Branch]
        F["📝 <b>Trait Text Prompts</b><br><small>('A dog with floppy ears', etc.)</small>"]:::data
        G["💬 <b>CLIP Text/Image Scorer</b><br><small>(Zero-Shot Contrastive)</small>"]:::model
        H["📊 <b>Zero-Shot Trait Probabilities</b><br><small>(P_CLIP)</small>"]:::process
    end

    %% Connections for Branches
    A -->|Image Pixels| B
    B -->|Projected| C
    C -->|Shared 256-D Hidden| D
    D --> E
    
    A -->|Image Pixels| G
    F -->|Text Tokens| G
    G --> H

    %% 4. Fusion Layer
    subgraph FusionLayer [Log-Space Ensemble Layer]
        I(("⚖️ <b>Ensemble Weighting</b><br><small>S = w·log(P_CLIP) + (1-w)·log(P_NN)</small>")):::process
        J["🧬 <b>Extracted Phenotype Profile</b><br><small>(Top-1 for all 6 canonical traits)</small>"]:::data
    end

    E -->|w = 0.35| I
    H -->|w = 0.65| I
    I --> J

    %% 5. Symbolic Reasoning Layer
    subgraph ReasoningLayer [Ontology Reasoning Layer]
        K[("🦉 <b>OWL Breed Ontology</b><br><small>(13 Purebreds + OOD Mixes)</small>")]:::data
        L["⚙️ <b>SPARQL Reasoner</b><br><small>(Trait Overlap Logic)</small>"]:::model
    end

    J -->|Query Inject| L
    K -->|Knowledge Base| L

    %% 6. Final Output
    M["🏆 <b>Ranked Ancestry Candidates</b><br><small>+ Explainable Trait Trace</small>"]:::output

    L -->|Overlap Count (e.g. 5/6)| M
