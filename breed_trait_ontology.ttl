@prefix : <http://straycare.org/ontology/breed#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://straycare.org/ontology/breed> rdf:type owl:Ontology ;
    rdfs:comment "StrayCare Breed & Trait Ontology (Dog module, v0.1). Knowledge Engineering lab project. Grounds breed-ancestry inference in explicit, queryable trait knowledge instead of a fixed closed-world breed list. Open this file directly in Protege (File > Open)." .

#################################################################
#    Core Classes
#################################################################

:Animal rdf:type owl:Class .
:Dog rdf:type owl:Class ; rdfs:subClassOf :Animal .
:Cat rdf:type owl:Class ; rdfs:subClassOf :Animal .   # placeholder — cat branch to be populated in a later milestone

:Breed rdf:type owl:Class .
:BreedGroup rdf:type owl:Class .
:Trait rdf:type owl:Class .

:EarShape rdf:type owl:Class ; rdfs:subClassOf :Trait .
:CoatType rdf:type owl:Class ; rdfs:subClassOf :Trait .
:CoatPattern rdf:type owl:Class ; rdfs:subClassOf :Trait .
:SizeClass rdf:type owl:Class ; rdfs:subClassOf :Trait .
:SnoutLength rdf:type owl:Class ; rdfs:subClassOf :Trait .
:TailCarriage rdf:type owl:Class ; rdfs:subClassOf :Trait .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :EarShape :CoatType :CoatPattern :SizeClass :SnoutLength :TailCarriage ) .

#################################################################
#    Object Properties
#################################################################

:belongsToGroup rdf:type owl:ObjectProperty ;
    rdfs:domain :Breed ;
    rdfs:range :BreedGroup .

:hasTrait rdf:type owl:ObjectProperty ;
    rdfs:domain :Breed ;
    rdfs:range :Trait .

:hasEarShape rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :EarShape .

:hasCoatType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :CoatType .

:hasCoatPattern rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :CoatPattern .

:hasSizeClass rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :SizeClass .

:hasSnoutLength rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :SnoutLength .

:hasTailCarriage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf :hasTrait ; rdfs:domain :Breed ; rdfs:range :TailCarriage .

#################################################################
#    Data Properties
#################################################################

:hasTraitDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Breed ; rdfs:range xsd:string ;
    rdfs:comment "Natural-language trait summary used to auto-generate ontology-grounded CLIP prompts." .

:originRegion rdf:type owl:DatatypeProperty ;
    rdfs:domain :Breed ; rdfs:range xsd:string .

#################################################################
#    Trait Individuals
#################################################################

:FloppyEars rdf:type owl:NamedIndividual , :EarShape .
:ErectEars rdf:type owl:NamedIndividual , :EarShape .
:SemiErectEars rdf:type owl:NamedIndividual , :EarShape .
:ButtonEars rdf:type owl:NamedIndividual , :EarShape .

:ShortCoat rdf:type owl:NamedIndividual , :CoatType .
:MediumCoat rdf:type owl:NamedIndividual , :CoatType .
:LongCoat rdf:type owl:NamedIndividual , :CoatType .
:WireCoat rdf:type owl:NamedIndividual , :CoatType .

:SolidColor rdf:type owl:NamedIndividual , :CoatPattern .
:Brindle rdf:type owl:NamedIndividual , :CoatPattern .
:Spotted rdf:type owl:NamedIndividual , :CoatPattern .
:Tricolor rdf:type owl:NamedIndividual , :CoatPattern .
:PatchedColor rdf:type owl:NamedIndividual , :CoatPattern .

:ToySize rdf:type owl:NamedIndividual , :SizeClass .
:SmallSize rdf:type owl:NamedIndividual , :SizeClass .
:MediumSize rdf:type owl:NamedIndividual , :SizeClass .
:LargeSize rdf:type owl:NamedIndividual , :SizeClass .
:GiantSize rdf:type owl:NamedIndividual , :SizeClass .

:ShortSnout rdf:type owl:NamedIndividual , :SnoutLength .
:MediumSnout rdf:type owl:NamedIndividual , :SnoutLength .
:LongSnout rdf:type owl:NamedIndividual , :SnoutLength .

:CurledTail rdf:type owl:NamedIndividual , :TailCarriage .
:StraightTail rdf:type owl:NamedIndividual , :TailCarriage .
:PlumeTail rdf:type owl:NamedIndividual , :TailCarriage .
:DockedTail rdf:type owl:NamedIndividual , :TailCarriage .

#################################################################
#    Breed Group Individuals
#################################################################

:SportingGroup rdf:type owl:NamedIndividual , :BreedGroup .
:HoundGroup rdf:type owl:NamedIndividual , :BreedGroup .
:WorkingGroup rdf:type owl:NamedIndividual , :BreedGroup .
:TerrierGroup rdf:type owl:NamedIndividual , :BreedGroup .
:ToyGroup rdf:type owl:NamedIndividual , :BreedGroup .
:SpitzGroup rdf:type owl:NamedIndividual , :BreedGroup .
:LocalIndigenousGroup rdf:type owl:NamedIndividual , :BreedGroup .

#################################################################
#    Breed Individuals  (13 Oxford-IIIT Pet dog breeds + 1 local phenotype)
#################################################################

:Beagle rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Beagle" ; :belongsToGroup :HoundGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :Tricolor ;
    :hasSizeClass :MediumSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A medium-sized hound with long floppy ears, a short tricolor coat, a moderate-length snout, and a straight tail often carried upright." .

:Boxer rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Boxer" ; :belongsToGroup :WorkingGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :Brindle ;
    :hasSizeClass :LargeSize ; :hasSnoutLength :ShortSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A large, muscular working dog with a short brindle coat, floppy ears, a short broad snout, and a straight tail." .

:Chihuahua rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Chihuahua" ; :belongsToGroup :ToyGroup ;
    :hasEarShape :ErectEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :ToySize ; :hasSnoutLength :ShortSnout ; :hasTailCarriage :CurledTail ;
    :hasTraitDescription "A very small toy dog with large erect ears, a short smooth coat, a short rounded snout, and a tail often carried curled over the back." .

:Pug rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Pug" ; :belongsToGroup :ToyGroup ;
    :hasEarShape :ButtonEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :ToySize ; :hasSnoutLength :ShortSnout ; :hasTailCarriage :CurledTail ;
    :hasTraitDescription "A small toy dog with a compact body, folded button ears, a short flat coat, a very short flat snout, and a tightly curled tail." .

:Samoyed rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Samoyed" ; :belongsToGroup :SpitzGroup ;
    :hasEarShape :ErectEars ; :hasCoatType :LongCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :MediumSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :PlumeTail ;
    :hasTraitDescription "A medium-to-large spitz-type dog with a thick white double coat, erect ears, a moderate-length snout, and a fluffy plume tail carried curled over the back." .

:ShibaInu rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Shiba Inu" ; :belongsToGroup :SpitzGroup ;
    :hasEarShape :ErectEars ; :hasCoatType :MediumCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :SmallSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :CurledTail ;
    :hasTraitDescription "A small spitz-type dog with a dense double coat, erect triangular ears, a moderate-length snout, and a tightly curled tail." .

:GreatPyrenees rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Great Pyrenees" ; :belongsToGroup :WorkingGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :LongCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :GiantSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :PlumeTail ;
    :hasTraitDescription "A giant working dog with a thick white long coat, drooping V-shaped ears, a moderate-length snout, and a plumed tail." .

:GermanShorthairedPointer rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "German Shorthaired Pointer" ; :belongsToGroup :SportingGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :Spotted ;
    :hasSizeClass :LargeSize ; :hasSnoutLength :LongSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A large sporting dog with a short liver-and-white spotted coat, floppy ears, a long snout, and a straight tail." .

:StaffordshireBullTerrier rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Staffordshire Bull Terrier" ; :belongsToGroup :TerrierGroup ;
    :hasEarShape :ButtonEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :Brindle ;
    :hasSizeClass :MediumSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A medium-sized, muscular terrier with a short brindle coat, small folded ears, a broad moderate-length snout, and a straight tapering tail." .

:YorkshireTerrier rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Yorkshire Terrier" ; :belongsToGroup :ToyGroup ;
    :hasEarShape :ErectEars ; :hasCoatType :LongCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :ToySize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A very small toy terrier with a long silky blue-and-tan coat, small erect V-shaped ears, a moderate-length snout, and a straight tail." .

:Pomeranian rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Pomeranian" ; :belongsToGroup :SpitzGroup ;
    :hasEarShape :ErectEars ; :hasCoatType :LongCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :ToySize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :PlumeTail ;
    :hasTraitDescription "A tiny spitz-type dog with a thick fluffy double coat, small erect ears, a short-to-moderate snout, and a plumed tail carried flat over the back." .

:BassetHound rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Basset Hound" ; :belongsToGroup :HoundGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :Tricolor ;
    :hasSizeClass :MediumSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A low, long-bodied hound with extremely long floppy ears, a short tricolor coat, a moderate-length snout, and a saber-shaped tail carried upright." .

:SaintBernard rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Saint Bernard" ; :belongsToGroup :WorkingGroup ;
    :hasEarShape :FloppyEars ; :hasCoatType :MediumCoat ; :hasCoatPattern :PatchedColor ;
    :hasSizeClass :GiantSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :StraightTail ;
    :hasTraitDescription "A giant working dog with a dense red-and-white patched coat, large drooping ears, a moderate-length snout, and a long straight tail." .

:LocalIndigenousDog rdf:type owl:NamedIndividual , :Breed , :Dog ;
    rdfs:label "Local/Indigenous Street Dog Phenotype" ; :belongsToGroup :LocalIndigenousGroup ;
    :hasEarShape :SemiErectEars ; :hasCoatType :ShortCoat ; :hasCoatPattern :SolidColor ;
    :hasSizeClass :MediumSize ; :hasSnoutLength :MediumSnout ; :hasTailCarriage :CurledTail ;
    :hasTraitDescription "A medium-sized, lean, athletic dog with a short coat (commonly solid or bicolor), semi-erect ears, a wedge-shaped head with a moderate-length snout, and a tail often carried curled upward — the common landrace phenotype of South Asian village and street dogs, not a formally recognized breed standard." ;
    rdfs:comment "PLACEHOLDER PROFILE: refine these trait values using the team's own locally-collected/annotated stray photos (Week-1 Day 3) rather than treating this as fixed." .
